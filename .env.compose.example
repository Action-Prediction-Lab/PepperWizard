# Configures docker-compose - TEMPORARY.
# Copy to `.env` at the project root — docker-compose auto-loads that filename
# before parsing docker-compose.yml. For container-side environment variables
# (NAOQI_IP, ANTHROPIC_API_KEY, etc.) see robot.env.example.
#
#   cp .env.compose.example .env

# Optional: shorten `docker compose -f ... -f ...` invocations to plain `docker compose ...`.
# Uncomment when you want the dev overlay loaded by default.
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# COMPOSE_PROFILES=gpu

# GPU exposure for stt-service.
#
# Defaults (no .env, or both lines unset/commented) → CPU + Whisper.
# To run Parakeet on an NVIDIA host: uncomment both lines below.
# Requires:
#   - nvidia-container-toolkit installed on the host
#   - the `nvidia` Docker runtime registered (check with `docker info | grep -i runtime`)
#
# STT_DOCKER_RUNTIME=nvidia
# STT_GPU_DEVICES=all
